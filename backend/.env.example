# ── Local development (docker-compose Postgres, host port 5433) ──────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/thewoman_crm?schema=public"

# ── Production: NeonDB (set this in Railway instead) ─────────────────────────
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/thewoman?sslmode=require"

# JWT — replace with long random strings before deploying
JWT_SECRET="change-me-access-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000
NODE_ENV=development

# Allowed CORS origin — the frontend
FRONTEND_URL="http://localhost:5173"
